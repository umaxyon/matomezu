{
  "modules": ["./register.ts"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*matomezu.*",
        "hooks": [{ "type": "command", "command": "matomezu claude-code hook permission" }]
      }
    ],
    "PostToolUse": [{ "hooks": [{ "type": "command", "command": "matomezu claude-code hook context-use" }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "matomezu claude-code hook prompt" }] }],
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "matomezu claude-code hook model" }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "matomezu claude-code hook stop" }] }],
    "PostModelSwitch": [{ "hooks": [{ "type": "command", "command": "matomezu claude-code hook model" }] }]
  }
}
