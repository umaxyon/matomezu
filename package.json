{
  "name": "matomezu-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts 5300",
    "build": "rm -rf web/dist && bun build web/index.html --outdir web/dist --production",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/examples/hoge-app",
    "test": "bun test",
    "e2e": "playwright test",
    "lint": "biome check",
    "format": "biome check --write",
    "build:engine": "bun build web/src/engine/engine.ts --target browser --format iife --minify --outfile internal/engine/engine.js"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@happy-dom/global-registrator": "^21.0.3",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "7.0.2"
  }
}
