{
  "enableArtifact": false,
  "skillOverrides": {
    "obsidian-bases": "off",
    "obsidian-cli": "off",
    "obsidian-markdown": "off",
    "json-canvas": "off",
    "deploy-to-vercel": "off",
    "vercel-cli-with-tokens": "off",
    "vercel-composition-patterns": "off",
    "vercel-optimize": "off",
    "vercel-react-best-practices": "off",
    "vercel-react-native-skills": "off",
    "vercel-react-view-transitions": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:pdf-to-report-pipeline": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:deep-research": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:skill-creator": "off",
    "orca-emulator": "off",
    "orca-emulator-android": "off",
    "orca-per-workspace-env": "off",
    "linear-tickets": "off",
    "orca-linear": "off",
    "dataviz": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bun scripts/read-guard.ts"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bun scripts/ask-log.ts hook"
          }
        ]
      }
    ]
  },
  "disableClaudeAiConnectors": true,
  "disableWorkflows": true,
  "permissions": {
    "deny": [
      "SendFeedback"
    ]
  }
}
